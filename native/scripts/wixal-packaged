#!/bin/zsh
set -eu
native_root="${0:A:h:h}"
native_app="/Applications/Wixal.app"
if [[ ! -x "$native_app/Contents/Resources/engine/wixal-engine" ]]; then
    native_app="$native_root/../release/native/Wixal.app"
fi
exec "$native_app/Contents/Resources/engine/wixal-engine" --terminal --runtime "$native_app/Contents/Resources/ollama" "$@"
