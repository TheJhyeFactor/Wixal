{
  "name": "wixal",
  "version": "0.7.10-alpha.2",
  "description": "Native local AI workspace for Mac, with agents, workflows and project tools.",
  "main": "app/main.cjs",
  "private": true,
  "scripts": {
    "start": "./script/build_and_run.sh",
    "test": "node --test test/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "native/.venv/bin/python native/scripts/package.py --alpha",
    "check": "node scripts/check.cjs",
    "assets": "node scripts/graphics.cjs && node scripts/icon.cjs",
    "media": "node scripts/capture-media.cjs",
    "test:connections": "node scripts/connections-smoke.cjs",
    "test:providers": "node scripts/providers-smoke.cjs",
    "test:refinement": "node scripts/refinement-smoke.cjs",
    "test:features": "node scripts/features-smoke.cjs",
    "runtime:stage": "node scripts/runtime-stage.cjs",
    "runtime:build": "node scripts/runtime-build.cjs",
    "test:runtime": "node scripts/runtime-smoke.cjs",
    "test:performance": "node scripts/performance-smoke.cjs",
    "test:browser": "env -u ELECTRON_RUN_AS_NODE electron scripts/browser-tools-smoke.cjs",
    "test:command-tools": "node scripts/command-tools-ui-smoke.cjs",
    "test:activity": "node scripts/activity-ui-smoke.cjs",
    "test:settings": "node scripts/settings-smoke.cjs",
    "test:launch": "node scripts/launch-smoke.cjs",
    "test:icons": "node scripts/icon-smoke.cjs",
    "test:sidebar": "node scripts/sidebar-smoke.cjs",
    "test:project-picker": "node scripts/project-picker-smoke.cjs",
    "test:models": "node scripts/model-picker-smoke.cjs",
    "test:model-library": "node scripts/model-library-smoke.cjs",
    "test:model-download-live": "node scripts/model-download-live-smoke.cjs",
    "test:workspace": "node scripts/workspace-ui-smoke.cjs",
    "test:chat-tools-live": "node scripts/chat-tools-live-smoke.cjs",
    "test:security": "node scripts/security-ui-smoke.cjs",
    "test:website": "node --test test/website-assessment.test.cjs",
    "test:website-ui": "node scripts/website-ui-smoke.cjs",
    "test:accounts": "node scripts/accounts-smoke.cjs",
    "test:memory": "node scripts/memory-smoke.cjs",
    "test:browser-regression": "env -u ELECTRON_RUN_AS_NODE electron scripts/browser-tools-regression.cjs",
    "test:jhye-live": "env -u ELECTRON_RUN_AS_NODE electron scripts/jhye-tools-live-smoke.cjs",
    "start:electron": "electron .",
    "package:electron": "node scripts/runtime-stage.cjs && electron-packager . Wixal --platform=darwin --arch=arm64 --asar.unpackDir='{app,node_modules}' --asar.unpack=package.json --extra-resource=runtime/ollama --extend-info=resources/Info.plist --out=release --overwrite --icon=assets/Wixal.icns --app-bundle-id=app.wixal.desktop --app-category-type=public.app-category.developer-tools --ignore='^/(native|runtime|release|test|scripts|artifacts|docs|assets/social|\\.git)($|/)' && node scripts/runtime-package.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.7",
    "jose": "^6.2.12",
    "marked": "^17.0.0",
    "node-pty": "1.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.5.1",
    "playwright": "^1.56.0"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "node-pty@1.1.0": true,
    "sharp@0.35.5": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheJhyeFactor/Wixal.git"
  },
  "bugs": {
    "url": "https://github.com/TheJhyeFactor/Wixal/issues"
  },
  "homepage": "https://thejhyefactor.github.io/Wixal/",
  "engines": {
    "node": ">=22"
  }
}
