{
  "name": "wixal",
  "version": "0.7.3",
  "description": "A local AI workspace for Mac. Project tools, local models and a real terminal.",
  "main": "app/main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:app": "node scripts/smoke.cjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "package": "electron-packager . Wixal --platform=darwin --arch=arm64 --asar.unpackDir='{app,node_modules}' --asar.unpack=package.json --extra-resource=runtime/ollama --extend-info=resources/Info.plist --out=release --overwrite --icon=assets/Wixal.icns --app-bundle-id=app.wixal.desktop --app-category-type=public.app-category.developer-tools --ignore='^/(runtime|release|test|scripts|artifacts|docs|\\.git)($|/)'",
    "check": "node scripts/check.cjs",
    "assets": "node scripts/graphics.cjs && node scripts/icon.cjs",
    "media": "node scripts/capture-media.cjs",
    "test:connections": "node scripts/connections-smoke.cjs",
    "test:providers": "node scripts/providers-smoke.cjs",
    "test:refinement": "node scripts/refinement-smoke.cjs",
    "test:features": "node scripts/features-smoke.cjs",
    "runtime:stage": "node scripts/runtime-stage.cjs",
    "runtime:build": "node scripts/runtime-build.cjs",
    "test:runtime": "node scripts/runtime-smoke.cjs",
    "prepackage": "node scripts/runtime-stage.cjs",
    "test:performance": "node scripts/performance-smoke.cjs",
    "test:browser": "env -u ELECTRON_RUN_AS_NODE electron scripts/browser-tools-smoke.cjs",
    "test:command-tools": "node scripts/command-tools-ui-smoke.cjs",
    "postpackage": "node scripts/runtime-package.cjs",
    "test:settings": "node scripts/settings-smoke.cjs",
    "test:sidebar": "node scripts/sidebar-smoke.cjs",
    "test:project-picker": "node scripts/project-picker-smoke.cjs",
    "test:models": "node scripts/model-picker-smoke.cjs",
    "test:model-library": "node scripts/model-library-smoke.cjs",
    "test:model-download-live": "node scripts/model-download-live-smoke.cjs",
    "test:workspace": "node scripts/workspace-ui-smoke.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.7",
    "jose": "^6.2.12",
    "marked": "^17.0.0",
    "node-pty": "1.1.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@electron/rebuild": "4.2.0",
    "electron": "44.5.1",
    "playwright": "^1.56.0"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "node-pty@1.1.0": true,
    "sharp@0.35.5": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheJhyeFactor/Wixal.git"
  },
  "bugs": {
    "url": "https://github.com/TheJhyeFactor/Wixal/issues"
  },
  "homepage": "https://github.com/TheJhyeFactor/Wixal",
  "engines": {
    "node": ">=22"
  }
}
